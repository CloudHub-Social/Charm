# Copy to personal-ios.env.local and replace each placeholder. This file is
# ignored by Git; the := form lets an explicit command-line value take priority.
: "${CHARM_APPLE_TEAM_ID:=YOUR_TEAM_ID}"
: "${CHARM_IOS_BUNDLE_ID:=com.example.charm.personal}"
: "${DEVELOPER_DIR:=/Applications/Xcode-beta.app/Contents/Developer}"
: "${VITE_SENTRY_ENVIRONMENT:=development}"
