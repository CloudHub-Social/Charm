{
  "name": "charm",
  "private": true,
  "version": "0.1.3",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.0.3",
  "scripts": {
    "prepare": "sh scripts/install-git-hooks.sh",
    "postinstall": "node scripts/install-knope.js",
    "setup:knope": "node scripts/install-knope.js",
    "knope": "knope",
    "document-change": "knope document-change",
    "dev": "vite",
    "build": "tsc && vite build && pnpm license:bundle:npm",
    "build:web": "tsc && vite build --mode web && pnpm license:bundle:npm",
    "build:tauri": "tsc && vite build && pnpm license:bundle:tauri",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "concurrently -k -s command-test -n server,test \"http-server storybook-static -p 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "docs:features:validate": "node scripts/sync-feature-docs.mjs",
    "docs:features:check": "node scripts/sync-feature-docs.mjs --check && FEATURE_DOCS_COMPARE=1 playwright test e2e/feature-docs-current.spec.ts --project=chromium",
    "docs:features:sync": "node scripts/sync-feature-docs.mjs --write",
    "knip": "knip",
    "tokens:pull": "node scripts/tokens-pull.mjs",
    "check:ios-config": "node scripts/check-ios-config.mjs",
    "check:observability-ratchet": "node scripts/check-observability-ratchet.mjs",
    "license:check": "node scripts/check-license-boundaries.mjs",
    "license:bundle:npm": "node scripts/generate-third-party-licenses.mjs --npm --copy-project-licenses --output dist/THIRD_PARTY_LICENSES.txt",
    "license:bundle:tauri": "node scripts/generate-third-party-licenses.mjs --npm --cargo --copy-project-licenses --output dist/THIRD_PARTY_LICENSES.txt"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@sentry/react": "^10.75.0",
    "@tanstack/react-query": "^5.103.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.5",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "emoji-picker-react": "^4.22.2",
    "emoji-regex": "^10.6.0",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "html-react-parser": "^6.1.8",
    "jotai": "^2.20.3",
    "katex": "^0.18.7",
    "linkify-react": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-virtuoso": "^4.18.13",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@storybook/test-runner": "^0.24.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "oxfmt": "^0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "playwright": "1.63.0",
    "postcss": "^8.5.28",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  },
  "types": ".design-sync/types/ds-entry.d.ts"
}
